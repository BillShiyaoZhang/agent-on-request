# Local demo settings. Copy this file to .env; .env is ignored by Git.
# Docker Compose uses this existing MiniMax China Token Plan key for both Hermes profiles.
MINIMAX_CN_API_KEY=
# Optional localhost port for Docker Compose (default 4327).
# DEMO_DOCKER_PORT=4327
# Docker builds the genuine KG-plugin provider and native workbench from this source checkout.
# KG_PLUGIN_SOURCE=../hermes-kg-plugin
# Optional localhost ports for the two native KG workbenches and Hermes dashboards.
# DEMO_ALICE_KG_PORT=8765
# DEMO_BOB_KG_PORT=8766
# DEMO_ALICE_HERMES_PORT=9119
# DEMO_BOB_HERMES_PORT=9121
# Role-local KG console and controller-service credentials are generated in the profile volumes.

# The dedicated demo automatically migrates an existing MiniMax key here.
MINIMAX_TOKEN_PLAN_KEY=
DEMO_PORT=4327

# npm run demo:hermes uses two dedicated local Hermes API server profiles.
DEMO_HERMES_ALICE_URL=http://127.0.0.1:8643
DEMO_HERMES_ALICE_KEY=
DEMO_HERMES_BOB_URL=http://127.0.0.1:8644
DEMO_HERMES_BOB_KEY=
# Optional absolute path if the direct bridge was built outside bridge/agent-comm-direct.
DEMO_AGENT_COMM_DIRECT=
