# Local demo settings. Copy this file to .env; .env is ignored by Git.
# The dedicated demo automatically migrates an existing MiniMax key here.
MINIMAX_TOKEN_PLAN_KEY=
DEMO_PORT=4327

# npm run demo:hermes uses two dedicated local Hermes API server profiles.
DEMO_HERMES_ALICE_URL=http://127.0.0.1:8643
DEMO_HERMES_ALICE_KEY=
DEMO_HERMES_BOB_URL=http://127.0.0.1:8644
DEMO_HERMES_BOB_KEY=
# Optional absolute path if the direct bridge was built outside bridge/agent-comm-direct.
DEMO_AGENT_COMM_DIRECT=
